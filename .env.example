# 활성 채널 (콤마로 구분, 지금은 slack만 지원)
ALERT_CHANNELS=slack

# /ingest 인증 — airflow_connection.md의 alert_server_token과 동일한 값
ALERT_SERVER_TOKEN=change-me

# SQLite 파일 경로 (상대경로면 프로젝트 루트 기준)
ALERT_DB_PATH=alert.db

# Slack — Bot Token (chat:write, pins:write 등), 알림 보낼 채널 ID
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL_ID=C0123456789

# Slack — Socket Mode용 App-Level Token (xapp-, connections:write 스코프). socket_listener.py 전용
SLACK_APP_TOKEN=xapp-...
